{
  "name": "@dignetwork/deploy-action",
  "version": "0.2.4",
  "private": true,
  "description": "Official GitHub Action to deploy a build to the DIG Network (push-to-deploy, preview-per-PR).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage",
    "coverage:gate": "node .github/scripts/coverage-gate.mjs 80",
    "check-action": "node .github/scripts/check-action.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "prettier": "^3.3.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DIG-Network/deploy-action.git"
  }
}
